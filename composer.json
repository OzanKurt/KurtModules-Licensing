{
  "name": "ozankurt/laravel-modules-licensing",
  "description": "Self-hosted software licensing for Laravel: issue/validate license keys, Ed25519 signed offline keys, seat activations, private Composer gating, and a Core-free client SDK.",
  "keywords": ["laravel", "filament", "kurtmodules", "licensing", "license-key", "composer"],
  "license": "MIT",
  "authors": [{ "name": "Ozan Kurt", "email": "ozankurt2@gmail.com" }],
  "require": {
    "php": "^8.3",
    "ext-sodium": "*",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "ozankurt/laravel-modules-core": "^1.0",
    "spatie/laravel-package-tools": "^1.92",
    "spatie/laravel-translatable": "^6.11"
  },
  "require-dev": {
    "filament/filament": "^3.0 || ^4.0 || ^5.0",
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.18",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0",
    "rector/rector": "^2.0"
  },
  "autoload": {
    "psr-4": { "Kurt\\Modules\\Licensing\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": {
      "Kurt\\Modules\\Licensing\\Tests\\": "tests/",
      "Database\\Factories\\Kurt\\Modules\\Licensing\\": "database/factories/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["Kurt\\Modules\\Licensing\\Providers\\LicensingServiceProvider"]
    }
  },
  "repositories": [
    { "type": "vcs", "url": "https://github.com/OzanKurt/KurtModules-Core" }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "lint": "vendor/bin/pint --test",
    "format": "vendor/bin/pint",
    "stan": "vendor/bin/phpstan analyse --memory-limit=2G"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
